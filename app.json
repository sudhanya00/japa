{
  "expo": {
    "name": "Japa - Meditation Counter",
    "slug": "japa-meditation",
    "version": "1.0.0",
    "description": "Minimalist meditation counter with beautiful mala beads. Track your japa practice with peaceful animations.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF5F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sudhanya.japa",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF5F0"
      },
      "package": "com.sudhanya.japa",
      "versionCode": 1,
      "permissions": [],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Japa - Meditation Counter",
      "shortName": "Japa",
      "description": "Minimalist meditation counter with beautiful mala beads",
      "themeColor": "#FF6B45",
      "backgroundColor": "#FFF5F0",
      "orientation": "portrait",
      "display": "standalone",
      "startUrl": "/",
      "lang": "en",
      "bundler": "metro",
      "template": "./web/index.html"
    },
    "extra": {
      "eas": {
        "projectId": "8f40cd7e-83a5-4dc3-84c1-4e82daa48e4a"
      }
    }
  }
}
